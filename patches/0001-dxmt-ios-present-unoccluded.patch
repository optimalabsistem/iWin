+"  float b = min_lum;\n"
+"  if (E >= KS) {\n"
+"    float T = (E - KS) /  (1 - KS);\n"
+"    float T_2 = T * T;\n"
+"    float T_3 = T_2 * T;\n"
+"    E = (2 * T_3 - 3 * T_2 + 1) * KS \n"
+"        + (T_3 - 2 * T_2 + T) * (1 - KS)\n"
+"        + (- 2 * T_3 + 3 * T_2) * max_lum;\n"
